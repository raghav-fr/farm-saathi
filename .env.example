# ==============================================================================
# FarmSaathi AI — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env
# ==============================================================================

# --- Firebase ---
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- Weather API (WeatherAPI.com — free tier) ---
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# --- Qdrant (vector store for RAG) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_DISEASE=disease_knowledge
QDRANT_COLLECTION_CROPS=crop_knowledge
QDRANT_COLLECTION_SCHEMES=scheme_knowledge
QDRANT_COLLECTION_ADVISORIES=advisories

# --- Local LLM via Ollama ---
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_EMBEDDING_MODEL=nomic-embed-text

# --- PostgreSQL (market prices + weather cache only) ---
DATABASE_URL=postgresql+asyncpg://farmsaathi:farmsaathi@localhost:5432/farmsaathi

# --- Redis (caching + Celery task queue) ---
REDIS_URL=redis://localhost:6379/0

# --- App Settings ---
APP_NAME=FarmSaathi AI
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Market API (data.gov.in) ---
MARKET_API_BASE=https://api.data.gov.in/resource
MARKET_API_KEY=your_data_gov_in_key

# --- Bhashini (multilingual — translation/TTS/STT) ---
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id

GOOGLE_WEATHER_API_KEY=your_google_weather_api_key_here
